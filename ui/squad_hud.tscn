[gd_scene format=3]

[ext_resource type="Script" path="res://ui/squad_hud.gd" id="1_hud"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.08, 0.1, 0.14, 0.85)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_tank"]
bg_color = Color(0.18, 0.52, 0.95, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_medic"]
bg_color = Color(0.18, 0.85, 0.42, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_striker"]
bg_color = Color(0.95, 0.35, 0.18, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_sta"]
bg_color = Color(0.95, 0.82, 0.25, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.12, 0.14, 0.18, 0.9)

[node name="SquadHUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
offset_left = 16.0
offset_top = 16.0
offset_right = 900.0
offset_bottom = 140.0
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10
mouse_filter = 2

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 24
mouse_filter = 2

[node name="Title" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 20
text = "SQUAD TACTICS (AUTONOMOUS BOTS)"

[node name="ElapsedLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.95, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 18
text = "MISSION TIME: 00:00.0"

[node name="EnemyCountLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.45, 0.45, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 18
text = "ZOMBIES: 0 Active"

[node name="SquadList" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 16
mouse_filter = 2

[node name="TankCard" type="PanelContainer" parent="Margin/VBox/SquadList"]
custom_minimum_size = Vector2(240, 75)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Margin/VBox/SquadList/TankCard"]
